{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Time Tracker",
  "version": "1.0.7",
  "identifier": "com.asg.timetracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Time Tracker",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "iOS": {
      "developmentTeam": ""
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/s-1ntez/time-tracker-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5RjVFMDdEMzVERDE0M0MKUldROEZOMDFmZUQxYWM1S3pMRnlQbHhHbGlIV0xEcjZEZGVuMTRhb00rUjNFd2RzWFlzSVA2MlkK"
    }
  }
}
